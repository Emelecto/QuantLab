# Supabase — Variables de entorno del frontend (QuantLab web)
# Copia este archivo a `.env.local` y completa los valores reales.
# El orquestador provee los valores definitivos de NEXT_PUBLIC_*.
#
# Nunca commitees .env.local (ya está ignorado en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker de backtest (motor QuantLab)
# Producción: https://quantlab-worker.onrender.com
# Local: http://localhost:8001
NEXT_PUBLIC_WORKER_URL=https://quantlab-worker.onrender.com
